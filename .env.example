# =============================================================
# Expense Tracker Backend - Environment Configuration
# =============================================================
# INSTRUCTIONS:
#   1. Copy this file to .env
#   2. Fill in ALL values with your actual credentials
#   3. NEVER commit .env to version control
# =============================================================

# ---------- Database ----------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# ---------- Flask ----------
FLASK_DEBUG=false
FLASK_SECRET_KEY=generate-a-random-64-char-hex-string
PORT=5001

# ---------- CORS ----------
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------- AWS Cognito ----------
COGNITO_USER_POOL_ID=your-region_poolId
COGNITO_REGION=ap-south-1
COGNITO_APP_CLIENT_ID=your-client-id
# NOTE: Do NOT set a client secret for public app clients (SPA/mobile)

# ---------- File Storage ----------
UPLOAD_FOLDER=uploads/receipts
MAX_UPLOAD_SIZE_MB=5

# ---------- Logging ----------
LOG_LEVEL=INFO
